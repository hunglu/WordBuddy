# Copy this file to .env (gitignored) to get started with docker-compose.
#
# GITHUB_TOKEN is used only as a BuildKit --secret when building each service's Docker image —
# a GitHub PAT with read:packages (write:packages too if you'll also run `make publish-shared`),
# scoped to this repo. It is never written into an image layer.

SA_PASSWORD=DevPassword123!
JWT_SECRET=dev-secret-do-not-use-in-production-must-be-at-least-32-characters
JWT_ISSUER=WordBuddy
JWT_EXPIRY_MINUTES=60

GITHUB_TOKEN=

IDENTITY_CONNECTION_STRING=Server=sqlserver;Database=WordBuddyIdentity;User Id=sa;Password=DevPassword123!;TrustServerCertificate=true
CONTENT_CONNECTION_STRING=Server=sqlserver;Database=WordBuddyContent;User Id=sa;Password=DevPassword123!;TrustServerCertificate=true
QUIZ_CONNECTION_STRING=Server=sqlserver;Database=WordBuddyQuiz;User Id=sa;Password=DevPassword123!;TrustServerCertificate=true
PROGRESS_CONNECTION_STRING=Server=sqlserver;Database=WordBuddyProgress;User Id=sa;Password=DevPassword123!;TrustServerCertificate=true
