# Copy to secret.env (gitignored) and replace every CHANGE_ME. Never commit secret.env.
# Generate secrets with: openssl rand -hex 24
# Use only letters and digits in the *_DB_PASSWORD values: they are also placed in the connection strings.
POSTGRES_PASSWORD=CHANGE_ME
IDENTITY_DB_PASSWORD=CHANGE_ME
CONTENT_DB_PASSWORD=CHANGE_ME
QUIZ_DB_PASSWORD=CHANGE_ME
PROGRESS_DB_PASSWORD=CHANGE_ME
# Same passwords as above, inside the connection strings.
Identity_ConnectionStrings__DefaultConnection=Host=postgres;Port=5432;Database=WordBuddyIdentity;Username=wb_identity;Password=CHANGE_ME
Content_ConnectionStrings__DefaultConnection=Host=postgres;Port=5432;Database=WordBuddyContent;Username=wb_content;Password=CHANGE_ME
Quiz_ConnectionStrings__DefaultConnection=Host=postgres;Port=5432;Database=WordBuddyQuiz;Username=wb_quiz;Password=CHANGE_ME
Progress_ConnectionStrings__DefaultConnection=Host=postgres;Port=5432;Database=WordBuddyProgress;Username=wb_progress;Password=CHANGE_ME
# At least 32 characters.
Jwt__Secret=CHANGE_ME_AT_LEAST_32_CHARACTERS_LONG
Messaging__RabbitMq__Username=wordbuddy
Messaging__RabbitMq__Password=CHANGE_ME
# First admin, created once by the Identity migrate init container. Password: at least 12 characters.
Bootstrap__Admin__Email=admin@example.com
Bootstrap__Admin__Password=CHANGE_ME_12_CHARS_MIN
