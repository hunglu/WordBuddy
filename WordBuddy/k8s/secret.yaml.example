# Copy to secret.yaml (gitignored) and fill in real values, then:
#   kubectl apply -f k8s/secret.yaml
#
# Never commit the filled-in secret.yaml.

apiVersion: v1
kind: Secret
metadata:
  name: wordbuddy-secrets
  namespace: wordbuddy
type: Opaque
stringData:
  SA_PASSWORD: "DevPassword123!"
  Jwt__Secret: "dev-secret-do-not-use-in-production-must-be-at-least-32-characters"
  Identity_ConnectionStrings__DefaultConnection: "Server=sqlserver;Database=WordBuddyIdentity;User Id=sa;Password=DevPassword123!;TrustServerCertificate=true"
  Content_ConnectionStrings__DefaultConnection: "Server=sqlserver;Database=WordBuddyContent;User Id=sa;Password=DevPassword123!;TrustServerCertificate=true"
  Quiz_ConnectionStrings__DefaultConnection: "Server=sqlserver;Database=WordBuddyQuiz;User Id=sa;Password=DevPassword123!;TrustServerCertificate=true"
  Progress_ConnectionStrings__DefaultConnection: "Server=sqlserver;Database=WordBuddyProgress;User Id=sa;Password=DevPassword123!;TrustServerCertificate=true"
