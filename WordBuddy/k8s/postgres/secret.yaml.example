# Copy to k8s/postgres/secret.yaml (gitignored) and fill in real values, then:
#   kubectl apply -f k8s/postgres/secret.yaml        (make k8s-apply DB=postgres does this)
#
# Same key names as k8s/secret.yaml.example, so the Deployments do not change.
# SA_PASSWORD is replaced by POSTGRES_PASSWORD. Never commit the filled-in secret.yaml.

apiVersion: v1
kind: Secret
metadata:
  name: wordbuddy-secrets
  namespace: wordbuddy
type: Opaque
stringData:
  POSTGRES_PASSWORD: "DevPassword123!"
  Jwt__Secret: "dev-secret-do-not-use-in-production-must-be-at-least-32-characters"
  Identity_ConnectionStrings__DefaultConnection: "Host=postgres;Port=5432;Database=WordBuddyIdentity;Username=postgres;Password=DevPassword123!"
  Content_ConnectionStrings__DefaultConnection: "Host=postgres;Port=5432;Database=WordBuddyContent;Username=postgres;Password=DevPassword123!"
  Quiz_ConnectionStrings__DefaultConnection: "Host=postgres;Port=5432;Database=WordBuddyQuiz;Username=postgres;Password=DevPassword123!"
  Progress_ConnectionStrings__DefaultConnection: "Host=postgres;Port=5432;Database=WordBuddyProgress;Username=postgres;Password=DevPassword123!"
  Messaging__RabbitMq__Username: "wordbuddy"
  Messaging__RabbitMq__Password: "change-me-local-only"
