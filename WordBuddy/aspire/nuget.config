<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!-- AppHost needs no WordBuddy.Shared.* package, so nuget.org is the only feed (no GitHub PAT). -->
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
</configuration>
