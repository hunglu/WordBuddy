{
  "Serilog": {
    "Using": [ "Serilog.Sinks.Console" ],
    "MinimumLevel": {
      "Default": "Warning",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "System": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "outputTemplate": "[{Timestamp:HH:mm:ss} {Level:u3}] ({CorrelationId}) {ServiceName} {Message:lj}{NewLine}{Exception}"
        }
      }
    ],
    "Enrich": [ "FromLogContext" ]
  },
  "Messaging": {
    "Transport": "RabbitMq",
    "RabbitMq": {
      "Host": "localhost",
      "VirtualHost": "/",
      "Username": "wordbuddy",
      "HeartbeatSeconds": 10,
      "RequestedConnectionTimeoutMs": 10000
    },
    "Outbox": {
      "QueryDelayMs": 1000,
      "DuplicateDetectionWindowSeconds": 1800
    },
    "Retry": {
      "IntervalsMs": [ 200, 1000, 5000 ]
    }
  },
  "SupportLinks": {
    "UnlinkOverrideWaitDays": 7,
    "InvitationExpiryDays": 7
  },
  "AllowedHosts": "*"
}
