{
  "Serilog": {
    "Using": [ "Serilog.Sinks.Console" ],
    "MinimumLevel": {
      "Default": "Warning",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "System": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "outputTemplate": "[{Timestamp:HH:mm:ss} {Level:u3}] ({CorrelationId}) {ServiceName} {Message:lj}{NewLine}{Exception}"
        }
      }
    ],
    "Enrich": [ "FromLogContext" ]
  },
  "Messaging": {
    "Transport": "RabbitMq",
    "RabbitMq": {
      "Host": "localhost",
      "VirtualHost": "/",
      "Username": "wordbuddy"
    }
  },
  "Autofill": {
    "TranslationLocales": [ "vi" ],
    "Dictionary": {
      "BaseUrl": "https://api.dictionaryapi.dev/api/v2/entries/en/",
      "TimeoutSeconds": 5
    },
    "Claude": {
      "BaseUrl": "https://api.anthropic.com/",
      "Model": "claude-sonnet-5-5",
      "ApiVersion": "2023-06-01",
      "MaxTokens": 4096,
      "TimeoutSeconds": 15
    },
    "Audio": {
      "TimeoutSeconds": 5,
      "MaxBytes": 2000000
    }
  },
  "AllowedHosts": "*"
}
