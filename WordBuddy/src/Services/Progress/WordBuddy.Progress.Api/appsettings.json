{
  "Serilog": {
    "Using": [ "Serilog.Sinks.Console" ],
    "MinimumLevel": {
      "Default": "Warning",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "System": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "outputTemplate": "[{Timestamp:HH:mm:ss} {Level:u3}] ({CorrelationId}) {ServiceName} {Message:lj}{NewLine}{Exception}"
        }
      }
    ],
    "Enrich": [ "FromLogContext" ]
  },
  "Messaging": {
    "Transport": "RabbitMq",
    "RabbitMq": {
      "Host": "localhost",
      "VirtualHost": "/",
      "Username": "wordbuddy",
      "HeartbeatSeconds": 10,
      "RequestedConnectionTimeoutMs": 10000
    },
    "Outbox": {
      "QueryDelayMs": 1000,
      "DuplicateDetectionWindowSeconds": 1800
    },
    "Retry": {
      "IntervalsMs": [ 200, 1000, 5000 ]
    }
  },
  "Services": {
    "Content": {
      "BaseUrl": "http://localhost:5081"
    }
  },
  "Vocabulary": {
    "Scheduling": {
      "DesiredRetention": 0.9,
      "MaximumIntervalDays": 36500,
      "LearningStepsMinutes": [ 1, 10 ],
      "RelearningStepsMinutes": [ 10 ],
      "MasteredStabilityDays": 21,
      "LeechLapses": 4,
      "MaxDueItems": 50,
      "SessionDurationMinutes": 30
    },
    "Grading": {
      "PictureChoice": { "FastMs": 3000, "SlowMs": 10000 },
      "ListeningChoice": { "FastMs": 4000, "SlowMs": 12000 },
      "Typing": { "FastMs": 6000, "SlowMs": 20000 },
      "ToleranceMs": 3000,
      "AgeGroupMultiplier": { "Child": 1.25, "Adult": 1.0 },
      "AgeBandMultiplier": { "Under7": 1.5, "Age7To9": 1.35, "Age10To12": 1.2, "Age13To17": 1.1, "Adult": 1.0 }
    },
    "NewWordCap": {
      "LowBacklogMax": 20,
      "LowBacklogCap": 10,
      "MediumBacklogMax": 40,
      "MediumBacklogCap": 8,
      "HighBacklogMax": 60,
      "HighBacklogCap": 6,
      "OverflowCap": 5
    }
  },
  "Challenges": {
    "DailyGoalCorrectDue": 10,
    "DailyGoalBonus": 10,
    "DailyPointCap": 200,
    "FastAnswerFloorMs": 800,
    "Capacity": 30,
    "OpenLeadHours": 24,
    "LifecycleTickSeconds": 60,
    "RecomputeIntervalMinutes": 5,
    "SchedulerEnabled": true
  },
  "AllowedHosts": "*"
}
