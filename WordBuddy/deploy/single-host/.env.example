# Copy to .env (gitignored) and replace every CHANGE_ME. Never commit .env.
# Generate secrets with:  openssl rand -hex 24
# Use only letters and digits in the *_PASSWORD values (they are placed in connection strings).

# --- Release ---
# Registry path of the images, without trailing slash (lower case).
IMAGE_REGISTRY=ghcr.io/OWNER
# Image tag to run, for example 1.0.0 (no "latest").
WORDBUDDY_VERSION=0.0.0

# --- Public address ---
# DNS name that points to this host. localhost = self-signed certificate for local smoke tests.
SITE_ADDRESS=wordbuddy.example.com

# --- Database (PostgreSQL) ---
POSTGRES_PASSWORD=CHANGE_ME
IDENTITY_DB_PASSWORD=CHANGE_ME
CONTENT_DB_PASSWORD=CHANGE_ME
QUIZ_DB_PASSWORD=CHANGE_ME
PROGRESS_DB_PASSWORD=CHANGE_ME
# Only for docker-compose.sqlserver.yml
# SA_PASSWORD=CHANGE_ME

# --- JWT ---
# At least 32 characters.
JWT_SECRET=CHANGE_ME_AT_LEAST_32_CHARACTERS_LONG
JWT_ISSUER=WordBuddy
JWT_EXPIRY_MINUTES=60

# --- RabbitMQ ---
RABBITMQ_USER=wordbuddy
RABBITMQ_PASSWORD=CHANGE_ME

# --- First admin (created once by identity-migrate if no admin exists) ---
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
# At least 12 characters. Change it after the first login, then you may blank this value.
BOOTSTRAP_ADMIN_PASSWORD=CHANGE_ME_12_CHARS_MIN
BOOTSTRAP_ADMIN_DISPLAY_NAME=Admin

# --- Optional ---
# Claude API key for lexeme autofill. Leave empty to disable.
AUTOFILL_CLAUDE_API_KEY=
# Trusted proxy network for X-Forwarded-For. Matches the Compose network (172.28.0.0/16).
FORWARDED_HEADERS_KNOWN_NETWORK=172.28.0.0/16
# Days to keep backups.
BACKUP_RETENTION_DAYS=14
