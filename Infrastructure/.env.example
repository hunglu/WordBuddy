# Copy this file to .env and fill in real values.
# .env is listed in .gitignore and must never be committed.

# ── SQL Server ───────────────────────────────────────────────
# Must satisfy SQL Server complexity: 8+ chars, upper, lower, digit, symbol.
SA_PASSWORD=YourStrong@Password123

# ── Connection string ────────────────────────────────────────
# "sqlserver" is the Docker Compose service name — resolved on the
# internal backend network. Use localhost,1433 when connecting from host.
CONNECTION_STRING=Server=sqlserver;Database=WordBuddy;User Id=sa;Password=YourStrong@Password123;TrustServerCertificate=true

# ── JWT ──────────────────────────────────────────────────────
# JWT_SECRET must be at least 32 characters (256-bit) for HS256.
JWT_SECRET=your-256-bit-secret-here-change-before-deploy
JWT_ISSUER=WordBuddy
JWT_EXPIRY_MINUTES=60
