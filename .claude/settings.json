{
  "permissions": {
    "deny": [
      "Bash(rm -rf:*)",
      "Bash(Remove-Item -Recurse -Force:*)",
      "Bash(git push --force:*)",
      "Bash(git push --force-with-lease:*)",
      "Bash(*DROP DATABASE*)",
      "Bash(*DROP TABLE*)",
      "Bash(docker system prune -a:*)",
      "Bash(aws ec2 terminate-instances:*)",
      "Bash(npm publish:*)",
      "Read(./WordBuddy/appsettings.Production.json)",
      "Read(./WordBuddy/**/appsettings.Production.json)",
      "Read(./WordBuddy/.env)",
      "Read(./WordBuddy.UI/.env)",
      "Read(./WordBuddy.UI/.env.*)",
      "Read(~/.aws/credentials)",
      "Read(~/.ssh/**)"
    ],
    "ask": [
      "Bash(dotnet ef database update:*)",
      "Bash(docker compose up:*)",
      "Bash(docker compose down:*)",
      "Bash(git push:*)",
      "Bash(gh issue create:*)",
      "Bash(gh issue edit:*)",
      "Bash(gh issue close:*)",
      "Bash(gh issue comment:*)",
      "Bash(gh pr create:*)",
      "Bash(gh pr merge:*)",
      "Bash(gh pr review:*)",
      "Bash(gh pr comment:*)",
      "Bash(gh pr edit:*)",
      "PowerShell(gh pr merge:*)",
      "PowerShell(gh pr review:*)",
      "PowerShell(gh pr comment:*)",
      "PowerShell(gh pr edit:*)",
      "PowerShell(gh issue create:*)",
      "PowerShell(gh issue edit:*)",
      "PowerShell(gh issue close:*)",
      "PowerShell(gh issue comment:*)",
      "PowerShell(gh pr create:*)",
      "Edit(./CLAUDE.md)",
      "Write(./CLAUDE.md)",
      "Edit(./**/CLAUDE.md)",
      "Write(./**/CLAUDE.md)"
    ],
    "allow": [
      "Bash(dotnet build:*)",
      "Bash(dotnet test:*)",
      "Bash(dotnet format:*)",
      "Bash(dotnet ef migrations list:*)",
      "Bash(npm run lint)",
      "Bash(npm run test:*)",
      "Bash(npm run build)",
      "Bash(git status)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)"
    ]
  },
  "enableAllProjectMcpServers": false,
  "enabledMcpjsonServers": [],
  "hooks": {
    "PreToolUse": [
      { "matcher": "Bash", "hooks": [{ "type": "command", "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/pre-tool-audit.js\"", "timeout": 10 }] }
    ],
    "PostToolUse": [
      { "matcher": "Write|Edit|MultiEdit", "hooks": [{ "type": "command", "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/pre-tool-audit.js\"" }] }
    ]
  }
}